# Configuracion del despliegue de Skills Book.
#
# Windows : copia este archivo como  servidor.env  (al lado del .bat).
# Docker  : copia este archivo como  .env  (al lado de docker-compose.yml).
#
# Formato: CLAVE=valor, una por linea, sin comillas y sin espacios alrededor
# del "=".  Las lineas que empiezan por # se ignoran.

# --- Donde se guardan las skills ------------------------------------------
# Una carpeta por skill, en disco. Es TODO el estado de la app: copiala y ya
# tienes la copia de seguridad. En Docker se ignora (siempre /data/skills).
# SKILLSBOOK_HOME=D:\SkillsBook\data\skills

# --- Red -------------------------------------------------------------------
# 0.0.0.0 = visible en toda la LAN. Para atarlo a una sola tarjeta de red,
# pon aqui la IP del servidor (ej. 192.168.1.50).
SKILLSBOOK_HOST=0.0.0.0
SKILLSBOOK_PORT=8777

# --- Acceso ----------------------------------------------------------------
# Con token, el navegador pide usuario y contrasena: el usuario da igual, la
# contrasena es este token. Sin token, cualquiera en la red puede editar y
# borrar skills. Genera uno largo, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# SKILLSBOOK_TOKEN=cambia-esto-por-un-token-largo

# --- Seguridad -------------------------------------------------------------
# Importar una carpeta "por ruta" lee el disco DEL SERVIDOR. En un despliegue
# compartido dejalo en 0: se importa por zip.
SKILLSBOOK_ALLOW_PATH_IMPORT=0

# --- Registro --------------------------------------------------------------
# 1 = anotar cada peticion (util para depurar, ruidoso a diario).
SKILLSBOOK_VERBOSE=0
